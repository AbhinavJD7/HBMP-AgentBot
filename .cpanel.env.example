# cPanel Environment Variables Template
# Copy this file to .env and fill in your actual values
# In cPanel Node.js Selector, add these as environment variables

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3080
HOST=0.0.0.0
TRUST_PROXY=1

# ============================================
# DATABASE CONFIGURATION
# ============================================
# MongoDB Connection String
# Format: mongodb://username:password@host:port/database
# OR for MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URI=mongodb://localhost:27017/LibreChat

# ============================================
# DOMAIN CONFIGURATION
# ============================================
# Replace with your actual domain
DOMAIN_CLIENT=https://yourdomain.com
DOMAIN_SERVER=https://yourdomain.com

# ============================================
# SEARCH CONFIGURATION (Meilisearch)
# ============================================
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=your_master_key_here
MEILI_NO_ANALYTICS=true

# ============================================
# API KEYS
# ============================================
# Add your API keys here
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GOOGLE_KEY=your-google-gemini-key-here

# ============================================
# SECURITY KEYS
# ============================================
# Generate secure random strings for these
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-jwt-secret-here
JWT_REFRESH_SECRET=your-random-jwt-refresh-secret-here
SESSION_SECRET=your-random-session-secret-here

# ============================================
# OPTIONAL CONFIGURATION
# ============================================
# File Upload Settings
FILE_UPLOAD_SIZE_LIMIT=10485760

# Email Configuration (if using email features)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Social Login (set to true to enable)
ALLOW_SOCIAL_LOGIN=false

# Compression (set to true to disable)
DISABLE_COMPRESSION=false

# ============================================
# NOTES
# ============================================
# 1. Replace all placeholder values with your actual configuration
# 2. Keep this file secure - never commit it to version control
# 3. In cPanel Node.js Selector, add each variable individually
# 4. Generate strong secrets for JWT_SECRET, JWT_REFRESH_SECRET, and SESSION_SECRET


